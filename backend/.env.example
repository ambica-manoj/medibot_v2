# Copy this file to .env and replace the placeholder values.
# Never commit real AWS credentials.

AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-south-1

S3_BUCKET_NAME=medibot-documents
BEDROCK_MODEL_ID=google.gemma-3-4b-it

LOCAL_INDEX_DIR=faiss_index
PRELOADED_PDF_PATH=
PRELOADED_S3_PREFIX=preloaded

FRONTEND_ORIGIN=http://localhost:3000

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
RRF_K=60
SCORE_THRESHOLD_RATIO=0.75
MAX_CHUNKS=8# AWS credentials (used by boto3 for Bedrock + S3)
# Get these from your AWS IAM user; see setup instructions
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=ap-south-1

# S3
S3_BUCKET_NAME=medibot-documents

# Bedrock
BEDROCK_MODEL_ID=google.gemma-3-4b-it

# App
LOCAL_INDEX_DIR=faiss_index
PRELOADED_PDF_PATH=C:\Users\Hello\Desktop\medibot-v2\medical.pdf
PRELOADED_S3_PREFIX=preloaded

# CORS - comma separated origins allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000
